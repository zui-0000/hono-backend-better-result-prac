        </mxCell>
        <mxCell id="c106" value="&lt;b&gt;ここがフロントの要。&lt;/b&gt;&lt;br&gt;401 を見たら 1 回だけ refresh を試す" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p5-1">
          <mxGeometry x="10" y="940" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c107" value="POST /auth/refresh   fetch(..., { credentials: &quot;include&quot; })" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p5-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="1020" as="sourcePoint" />
            <mxPoint x="675" y="1020" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c108" value="Cookie: refresh_token を&lt;b&gt;ブラウザが自動で添付&lt;/b&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#82b366;labelBackgroundColor=none;" edge="1" parent="p5-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="1055" as="sourcePoint" />
            <mxPoint x="675" y="1055" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c109" value="旧行を失効 + 新行を INSERT   (1 トランザクション)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p5-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="675" y="1090" as="sourcePoint" />
            <mxPoint x="925" y="1090" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c110" value="200 {accessToken}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="p5-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="675" y="1125" as="sourcePoint" />
            <mxPoint x="140" y="1125" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c111" value="Set-Cookie: 新しい refresh_token" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#82b366;labelBackgroundColor=none;" edge="1" parent="p5-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="675" y="1160" as="sourcePoint" />
            <mxPoint x="410" y="1160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c112" value="GET /users/{id} を&lt;b&gt;再送&lt;/b&gt;   (新しい券で)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p5-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="1195" as="sourcePoint" />
            <mxPoint x="675" y="1195" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c113" value="200 {user}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="p5-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="675" y="1230" as="sourcePoint" />
            <mxPoint x="140" y="1230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c114" value="いま持っているもの —  メモリ: 新しい accessToken  /  Cookie: 新しい refresh_token　　←　&lt;b&gt;2 枚とも入れ替わる&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="p5-1">
          <mxGeometry x="20" y="1250" width="990" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c115" value="⑤  ログアウト" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="p5-1">
          <mxGeometry x="20" y="1300" width="990" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c116" value="POST /auth/logout   Authorization: Bearer …" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p5-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="1370" as="sourcePoint" />
            <mxPoint x="675" y="1370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c117" value="UPDATE revoked_at   (そのセッションだけ)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p5-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="675" y="1405" as="sourcePoint" />
            <mxPoint x="925" y="1405" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c118" value="Set-Cookie: refresh_token=;  Max-Age=0" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#82b366;labelBackgroundColor=none;" edge="1" parent="p5-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="675" y="1440" as="sourcePoint" />
            <mxPoint x="410" y="1440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c119" value="204" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="p5-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="675" y="1475" as="sourcePoint" />
            <mxPoint x="140" y="1475" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c120" value="&lt;b&gt;メモリの accessToken を自分で捨てる。&lt;/b&gt;&lt;br&gt;捨てないと最大 1 時間そのまま通る" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p5-1">
          <mxGeometry x="10" y="1495" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c121" value="いま持っているもの —  メモリ: なし  /  Cookie: なし" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="p5-1">
          <mxGeometry x="20" y="1560" width="990" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c122" value="&lt;b&gt;緑の矢印はフロントの JS が一切触れない経路。&lt;/b&gt; リフレッシュ券は Cookie 保管庫とサーバの間だけを往復し、&lt;br&gt;JS からは存在すら見えない (HttpOnly)。フロントが手で持つのは短命なアクセストークン 1 枚だけ。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p5-1">
          <mxGeometry x="20" y="1615" width="990" height="62" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
