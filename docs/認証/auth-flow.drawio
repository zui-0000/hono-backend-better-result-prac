        </mxCell>
        <mxCell id="c94" value="INSERT t_refresh_token   (保存するのは SHA-256 だけ)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p5-1">
