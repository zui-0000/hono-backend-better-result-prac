        <mxCell id="c67" value="&lt;b&gt;usable&lt;/b&gt; → ローテーション" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p4-1">
