          </mxGeometry>
        </mxCell>
        <mxCell id="c91" value="いま持っているもの —  メモリ: なし  /  Cookie: なし　　←　&lt;b&gt;作成しても券は出ない。ログインは別の操作。&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="p5-1">
          <mxGeometry x="20" y="295" width="990" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c92" value="②  ログイン" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="p5-1">
          <mxGeometry x="20" y="345" width="990" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c93" value="POST /auth/login   {mailAddress, password}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p5-1">
          <mxGeometry relative="1" as="geometry">
