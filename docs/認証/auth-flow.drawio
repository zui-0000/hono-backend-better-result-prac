          <mxGeometry x="340" y="520" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c61" value="失効から&lt;br&gt;30 秒以内?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p4-1">
          <mxGeometry x="340" y="655" width="240" height="90" as="geometry" />
