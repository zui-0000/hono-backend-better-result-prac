        <mxCell id="c65" value="&lt;b&gt;revoked&lt;/b&gt; → 401&lt;br&gt;ログアウト / 盗難検出で切った行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p4-1">
