<mxfile host="Electron" type="device">
  <diagram id="page-1" name="1-全体像">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="p0-0" />
        <mxCell id="p0-1" parent="p0-0" />
        <mxCell id="c1" value="認証の全体像 — 券は 2 枚ある" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;" vertex="1" parent="p0-1">
          <mxGeometry x="40" y="30" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="ブラウザ" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=none;strokeColor=#888888;dashed=1;verticalAlign=top;fontStyle=1;spacingTop=8;fontSize=14;" vertex="1" parent="p0-1">
          <mxGeometry x="60" y="100" width="330" height="350" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="アクセストークン (JWT)&lt;br&gt;&lt;br&gt;保管: クライアントのメモリ (想定)&lt;br&gt;寿命: &lt;b&gt;1 時間&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p0-1">
          <mxGeometry x="85" y="160" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="リフレッシュトークン (乱数)&lt;br&gt;&lt;br&gt;保管: Cookie (&lt;b&gt;HttpOnly&lt;/b&gt;)&lt;br&gt;寿命: &lt;b&gt;2 日&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p0-1">
          <mxGeometry x="85" y="305" width="280" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="サーバ" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=none;strokeColor=#888888;dashed=1;verticalAlign=top;fontStyle=1;spacingTop=8;fontSize=14;" vertex="1" parent="p0-1">
          <mxGeometry x="710" y="100" width="350" height="350" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="署名と有効期限を見るだけ&lt;br&gt;&lt;b&gt;DB を引かない&lt;/b&gt;&lt;br&gt;(HS256 / 鍵は 32 文字以上)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p0-1">
          <mxGeometry x="735" y="160" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="SHA-256 にして照合&lt;br&gt;t_refresh_token&lt;br&gt;&lt;b&gt;券そのものは保存しない&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p0-1">
          <mxGeometry x="735" y="305" width="300" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="Authorization: Bearer …&lt;br&gt;すべての保護 API" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#6c8ebf;labelBackgroundColor=none;" edge="1" parent="p0-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="390" y="212" as="sourcePoint" />
            <mxPoint x="710" y="212" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c9" value="Cookie: refresh_token&lt;br&gt;&lt;b&gt;POST /auth/refresh だけ&lt;/b&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#82b366;labelBackgroundColor=none;" edge="1" parent="p0-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="390" y="360" as="sourcePoint" />
            <mxPoint x="710" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c10" value="なぜ 2 枚に分けるか — 毎回の API に流すのは短命な券だけにして、長命な券は 1 経路にしか流さない。&lt;br&gt;アクセス券が漏れても 1 時間で切れ、リフレッシュ券は HttpOnly なので XSS を踏んでも JS から読めない。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p0-1">
          <mxGeometry x="60" y="490" width="1000" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-2" name="2-ログイン">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="715" math="0" shadow="0">
      <root>
        <mxCell id="p1-0" />
        <mxCell id="p1-1" parent="p1-0" />
        <mxCell id="c11" value="ログイン — 2 枚の券を発行する" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="20" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="クライアント" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="70" width="150" height="575" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="auth コンテキスト" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p1-1">
          <mxGeometry x="300" y="70" width="200" height="575" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="user コンテキスト" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p1-1">
          <mxGeometry x="620" y="70" width="180" height="575" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="DB  t_refresh_token" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p1-1">
          <mxGeometry x="890" y="70" width="180" height="575" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="POST /auth/login  {mailAddress, password}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p1-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="155" as="sourcePoint" />
            <mxPoint x="400" y="155" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c17" value="verifyCredentials(mailAddress, password)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p1-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="205" as="sourcePoint" />
            <mxPoint x="710" y="205" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c18" value="userId、居なければ undefined" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="p1-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="710" y="247" as="sourcePoint" />
            <mxPoint x="400" y="247" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c19" value="undefined なら 401。&lt;br&gt;&lt;b&gt;「居ない」と「合わない」を畳んである&lt;/b&gt; —&lt;br&gt;書き分けると相手の実在を教えてしまう" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p1-1">
          <mxGeometry x="255" y="265" width="290" height="62" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="sessionId を採番 (UUIDv7)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="p1-1">
          <mxGeometry x="255" y="345" width="290" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="リフレッシュ券 = 予測できない乱数&lt;br&gt;&lt;b&gt;保存するのはその SHA-256 だけ&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p1-1">
          <mxGeometry x="255" y="397" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="INSERT (token_hash, session_id, user_id, expires_at)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p1-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="480" as="sourcePoint" />
            <mxPoint x="980" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c23" value="JWT に署名   {sub, sid, iat, exp}&lt;br&gt;HS256 / 1 時間" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p1-1">
          <mxGeometry x="255" y="500" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="200 {accessToken}&lt;br&gt;Set-Cookie: refresh_token  (HttpOnly, Path=/auth/refresh)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p1-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="615" as="sourcePoint" />
            <mxPoint x="115" y="615" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c25" value="ログインのたびに sessionId を採番する。据え置くと更新のたびにログアウトの単位が変わってしまう。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="660" width="1030" height="34" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-3" name="3-保護された API">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="p2-0" />
        <mxCell id="p2-1" parent="p2-0" />
        <mxCell id="c26" value="保護された API — DB を引かずに「誰か」を決める" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="20" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="クライアント" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="70" width="150" height="560" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="verifyBearer&lt;br&gt;(shared/presentation)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2-1">
          <mxGeometry x="300" y="70" width="220" height="560" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="controller / command" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2-1">
          <mxGeometry x="640" y="70" width="200" height="560" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="DB" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2-1">
          <mxGeometry x="920" y="70" width="150" height="560" as="geometry" />
        </mxCell>
        <mxCell id="c31" value="GET /users/{id}&lt;br&gt;Authorization: Bearer …" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p2-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="165" as="sourcePoint" />
            <mxPoint x="410" y="165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c32" value="署名と exp を検証する&lt;br&gt;&lt;b&gt;アルゴリズムを HS256 に固定&lt;/b&gt; —&lt;br&gt;alg:none を名乗る券はここで落ちる" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2-1">
          <mxGeometry x="255" y="185" width="310" height="62" as="geometry" />
        </mxCell>
        <mxCell id="c33" value="失敗 → 401  (&lt;b&gt;DB は引かない&lt;/b&gt;)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p2-1">
          <mxGeometry x="255" y="265" width="310" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c34" value="JWT の sub / sid を&lt;br&gt;AuthenticatedCaller {userId, sessionId} に直す" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="p2-1">
          <mxGeometry x="255" y="317" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c35" value="auth = {userId, sessionId}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p2-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="400" as="sourcePoint" />
            <mxPoint x="740" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c36" value="checkUserIsSelf(target, actor)&lt;br&gt;別人の id なら 403" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p2-1">
          <mxGeometry x="610" y="420" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c37" value="SELECT …" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p2-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="510" as="sourcePoint" />
            <mxPoint x="995" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c38" value="" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="p2-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="995" y="545" as="sourcePoint" />
            <mxPoint x="740" y="545" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c39" value="200" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p2-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="610" as="sourcePoint" />
            <mxPoint x="115" y="610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c40" value="&lt;b&gt;ここまでセッションの生死を DB に問い合わせない。&lt;/b&gt; それが速さの理由であり、同時に弱点でもある —&lt;br&gt;ログアウトしても、発行済みのアクセス券は最大 1 時間そのまま通る。1 時間という寿命はその許容量そのもの。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="665" width="1030" height="62" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-4" name="4-リフレッシュ">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="735" math="0" shadow="0">
      <root>
        <mxCell id="p3-0" />
        <mxCell id="p3-1" parent="p3-0" />
        <mxCell id="c41" value="リフレッシュ — 使うたびに券を差し替える" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="20" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c42" value="クライアント" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="70" width="150" height="570" as="geometry" />
        </mxCell>
        <mxCell id="c43" value="auth コンテキスト" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p3-1">
          <mxGeometry x="300" y="70" width="200" height="570" as="geometry" />
        </mxCell>
        <mxCell id="c44" value="DB  t_refresh_token" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p3-1">
          <mxGeometry x="640" y="70" width="220" height="570" as="geometry" />
        </mxCell>
        <mxCell id="c45" value="POST /auth/refresh&lt;br&gt;Cookie: refresh_token" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p3-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="115" y="165" as="sourcePoint" />
            <mxPoint x="400" y="165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c46" value="提示された券を SHA-256 にする" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="p3-1">
          <mxGeometry x="260" y="185" width="280" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c47" value="SELECT WHERE token_hash = ?" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p3-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="250" as="sourcePoint" />
            <mxPoint x="750" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c48" value="該当する行、無ければ undefined" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#666666;" edge="1" parent="p3-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="750" y="288" as="sourcePoint" />
            <mxPoint x="400" y="288" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c49" value="なし → 401&lt;br&gt;&lt;b&gt;知らない券も、下の 401 と同じ本文&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p3-1">
          <mxGeometry x="260" y="306" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c50" value="classifyRefreshToken()  → usable&lt;br&gt;(判定は次ページ)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p3-1">
          <mxGeometry x="260" y="376" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c51" value="旧行を revoked (reason = rotated) + 新行を INSERT&lt;br&gt;&lt;b&gt;1 トランザクション&lt;/b&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p3-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="470" as="sourcePoint" />
            <mxPoint x="750" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c52" value="JWT を再署名&lt;br&gt;&lt;b&gt;sessionId は据え置く&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p3-1">
          <mxGeometry x="260" y="490" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c53" value="200 {accessToken}&lt;br&gt;Set-Cookie: 新しい refresh_token" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p3-1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="610" as="sourcePoint" />
            <mxPoint x="115" y="610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c54" value="セッションを採番し直さないのは、ログアウトの単位を変えないため。券の id は差し替えのたびに変わるが、&lt;br&gt;sessionId はログインからログアウトまで不変。失効と発行を 1 トランザクションにするのは、間で落ちると再ログインしか道が無くなるから。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="655" width="860" height="62" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-5" name="5-券の状態判定">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1010" pageHeight="990" math="0" shadow="0">
      <root>
