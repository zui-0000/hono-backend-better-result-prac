        <mxCell id="c96" value="Set-Cookie: refresh_token   (HttpOnly)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#82b366;labelBackgroundColor=none;" edge="1" parent="p5-1">
