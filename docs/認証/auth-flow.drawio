        <mxCell id="c168" value="ログアウト / refresh 失敗" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=12;fontStyle=1;strokeWidth=1.5;strokeColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="p8-1">
