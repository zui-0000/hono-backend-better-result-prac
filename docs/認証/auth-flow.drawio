        <mxCell id="c97" value="いま持っているもの —  メモリ: accessToken (1 時間)  /  Cookie: refresh_token (2 日・使うたびに延びる)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="p5-1">
          <mxGeometry x="20" y="540" width="990" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c98" value="③  認証が要る API を呼ぶ" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="p5-1">
          <mxGeometry x="20" y="590" width="990" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c99" value="GET /users/{id}   Authorization: Bearer …" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=12;strokeWidth=1.5;strokeColor=#333333;labelBackgroundColor=none;" edge="1" parent="p5-1">
