          </mxGeometry>
        </mxCell>
        <mxCell id="c161" value="&lt;b&gt;置き場が 1 つでないと成立しない理由がこの図。&lt;/b&gt; 券を書くのはログインだけではなく、1 時間ごとの refresh も書く。&lt;br&gt;読むのは画面 (React の中) だけではなく、fetch ラッパー (React の外) も読む。&lt;b&gt;両方に届く場所&lt;/b&gt;は zustand の store か素のモジュール変数しかない。" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p7-1">
          <mxGeometry x="40" y="640" width="950" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-9" name="9-ログイン判定の遷移">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="495" math="0" shadow="0">
