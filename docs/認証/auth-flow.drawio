        <mxCell id="c62" value="&lt;b&gt;reused&lt;/b&gt; — 盗難のサイン" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p4-1">
