        </mxCell>
        <mxCell id="c63" value="Cookie が無い / 知らない券&lt;br&gt;→ 401" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p4-1">
          <mxGeometry x="690" y="163" width="280" height="54" as="geometry" />
