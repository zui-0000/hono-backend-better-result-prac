        <mxCell id="c87" value="①  ユーザー作成" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontStyle=1;fontSize=14;" vertex="1" parent="p5-1">
