        <mxCell id="c58" value="expires_at を&lt;br&gt;過ぎている?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p4-1">
          <mxGeometry x="340" y="270" width="240" height="90" as="geometry" />
