        <mxCell id="c169" value="ログイン成功" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=12;fontStyle=1;strokeWidth=1.5;strokeColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="p8-1">
